{
  "config_version": 8,
  "backend": "pymupdf",
  "first_pages": 3,
  "last_pages": 0,
  "missing_value": "未知",
  "require_preview": true,
  "remember_mode": true,
  "last_mode": "",
  "last_dir": "",
  "excel_strategy": "append",
  "max_filename_len": 120,
  "contract_type_gate": true,
  "contract_gate_threshold": 2,
  "last_input_mode": "folder",
  "scan_ocr_enabled": true,
  "scan_ocr_max_pages": 2,
  "scan_ocr_include_last_page": true,
  "scan_ocr_dpi": 200,
  "scan_ocr_max_side": 2400,
  "scan_ocr_timeout": 60,
  "scan_ocr_lang": "auto",
  "scan_rapid_enabled": true,
  "capture_field_images": true,
  "sequence_counter": 1,
  "modes": {
    "paper": {
      "label": "论文",
      "icon": "📄",
      "description": "论文 / 期刊文献：题目、作者、期刊、发表年份",
      "template": "{论文题目}_{作者}_{发表年份}",
      "sheet": "论文汇总",
      "fields": [
        {
          "name": "论文题目",
          "keywords": [
            "论文题目",
            "文章题目",
            "题名",
            "题目",
            "标题",
            "Title",
            "Article Title"
          ],
          "regex": "(?:论文题目|文章题目|题\\s*名|题\\s*目|标\\s*题|Title)[ \\t]*[:：][ \\t]*([^\\r\\n]{2,150})",
          "enabled": true,
          "required": true,
          "type": "text",
          "max_len": 80,
          "source": "paper_title"
        },
        {
          "name": "作者",
          "keywords": [
            "作者",
            "著者",
            "作者姓名",
            "Authors",
            "Author"
          ],
          "regex": "(?:作\\s*者|著\\s*者|Authors?|作者姓名)[ \\t]*[:：][ \\t]*([^\\r\\n]{1,150})",
          "enabled": true,
          "required": true,
          "type": "list",
          "max_len": 40,
          "source": "paper_authors"
        },
        {
          "name": "期刊",
          "keywords": [
            "期刊",
            "刊名",
            "发表于",
            "来源期刊",
            "会议名称",
            "Journal",
            "Source",
            "Conference"
          ],
          "regex": "(?:期\\s*刊|刊\\s*名|发表于|来源期刊|会议名称|Journal|Source|Conference)[ \\t]*[:：][ \\t]*([^\\r\\n]{1,100})",
          "enabled": true,
          "required": false,
          "type": "text",
          "max_len": 50,
          "source": "paper_venue"
        },
        {
          "name": "发表年份",
          "keywords": [
            "发表年份",
            "出版年份",
            "年份",
            "发表日期",
            "出版日期",
            "Year",
            "Published"
          ],
          "regex": "(?:发表年份|出版年份|年\\s*份|发表日期|出版日期|Year|Published)\\D{0,12}((?:19|20)\\d{2})",
          "enabled": true,
          "required": true,
          "type": "year",
          "max_len": 4,
          "source": "paper_year"
        }
      ]
    },
    "contract": {
      "label": "合同",
      "icon": "📃",
      "description": "劳动合同/劳务合同：类型、乙方、身份证、期限、签订日期、用工部门",
      "template": "{合同类型}_{签订年份}_{序号}_{乙方}",
      "sheet": "合同汇总",
      "fields": [
        {
          "name": "合同类型",
          "keywords": [
            "合同类型",
            "合同类别",
            "合同性质",
            "用工形式",
            "合同名称"
          ],
          "regex": "(?:合同类型|合同类别|合同性质|用工形式)[ \\t]*[:：][ \\t]*([^\\r\\n]{2,20})",
          "enabled": true,
          "required": true,
          "type": "enum",
          "max_len": 20,
          "choices": [
            "劳动合同",
            "劳务合同"
          ]
        },
        {
          "name": "乙方",
          "keywords": [
            "乙方（签字）",
            "乙方(签字)",
            "乙方签字",
            "乙方签名",
            "乙方",
            "劳动者",
            "受雇人"
          ],
          "regex": "(?:乙\\s*方|劳动者|受雇人)\\s*(?:[（(][^）)\\r\\n]{0,10}[）)])?[ \\t]*[:：][ \\t]*([^\\r\\n]{2,20})",
          "enabled": true,
          "required": true,
          "type": "person_name",
          "max_len": 20
        },
        {
          "name": "身份证号",
          "keywords": [
            "身份证号",
            "身份证号码",
            "公民身份号码",
            "身份证编号",
            "身份证"
          ],
          "regex": "(?:身份证号|身份证号码|公民身份号码|身份证编号|身份证)[ \\t]*[:：][ \\t]*([0-9OolI]{15,18}[0-9XxOolI]?)",
          "enabled": true,
          "required": true,
          "type": "idcard",
          "max_len": 18
        },
        {
          "name": "开始日期",
          "keywords": [
            "合同期限",
            "合同起止日期",
            "开始日期",
            "起始日期",
            "合同期限自",
            "合同期限：自"
          ],
          "regex": "(?:开始日期|起始日期|合同期限)[^\\r\\n]{0,20}((?:19|20)\\d{2})\\s*[年/\\-\\.]\\s*(\\d{1,2})\\s*[月/\\-\\.]\\s*(\\d{1,2})",
          "enabled": true,
          "required": true,
          "type": "date",
          "max_len": 16
        },
        {
          "name": "结束日期",
          "keywords": [
            "结束日期",
            "截止日期",
            "合同期限至",
            "终止日期",
            "合同期限：至"
          ],
          "regex": "(?:结束日期|截止日期|终止日期|合同期限至)[^\\r\\n]{0,20}((?:19|20)\\d{2})\\s*[年/\\-\\.]\\s*(\\d{1,2})\\s*[月/\\-\\.]\\s*(\\d{1,2})",
          "enabled": true,
          "required": true,
          "type": "date",
          "max_len": 16
        },
        {
          "name": "签订日期",
          "keywords": [
            "签订日期",
            "签署日期",
            "签约日期",
            "签订时间",
            "签署时间",
            "合同日期",
            "签约时间",
            "订立日期",
            "合同订立时间"
          ],
          "regex": "(?:签订日期|签署日期|签约日期|签订时间|签署时间|合同日期|签约时间|订立日期|合同订立时间)[ \\t]*[:：][ \\t]*([^\\r\\n]{2,60})",
          "enabled": true,
          "required": true,
          "type": "date",
          "max_len": 16
        },
        {
          "name": "用工部门",
          "keywords": [
            "用工部门",
            "工作部门",
            "所属部门",
            "部门",
            "用工单位"
          ],
          "regex": "(?:用工部门|工作部门|所属部门|部门|用工单位)[ \\t]*[:：][ \\t]*([^\\r\\n]{2,20})",
          "enabled": true,
          "required": true,
          "type": "enum",
          "max_len": 20,
          "choices": [
            "办公室",
            "财务室",
            "交通",
            "物业",
            "服务一部",
            "服务二部",
            "资产"
          ]
        }
      ]
    }
  }
}